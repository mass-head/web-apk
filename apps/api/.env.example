# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Authentication & Tokens
API_KEY_SECRET=your-secure-api-key-secret-placeholder
JWT_SECRET=your-jwt-secret-for-download-tokens-placeholder
JWT_EXPIRY_SECONDS=1800

# PostgreSQL Configuration
DATABASE_URL=postgresql://web2apk:web2apk_password@localhost:5432/web2apk_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=web2apk_db
POSTGRES_USER=web2apk
POSTGRES_PASSWORD=web2apk_password

# Redis & BullMQ Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BUILD_CONCURRENCY=1

# Object Storage (S3 / MinIO)
STORAGE_DRIVER=s3 # 's3' or 'local'
S3_ENDPOINT=http://localhost:9000 # Leave empty for AWS S3
S3_REGION=us-east-1
S3_BUCKET_NAME=web2apk-artifacts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Local Storage Directory (Used if STORAGE_DRIVER=local)
LOCAL_STORAGE_DIR=./data/storage

# Rate Limiting & Quotas
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_CONCURRENT_JOBS_PER_USER=3
DAILY_CONVERSIONS_PER_USER=20

# Quotas & Limits
MAX_UPLOAD_SIZE_BYTES=1073741824 # 1 GB

# Android build timings and Gradle resources
# JOB_TIMEOUT_MS must stay above GRADLE_TIMEOUT_MS (enforced at startup).
JOB_TIMEOUT_MS=1200000 # 20 minutes
GRADLE_TIMEOUT_MS=900000 # 15 minutes
GRADLE_MAX_HEAP=2048m
GRADLE_MAX_METASPACE=512m
GRADLE_OFFLINE=true
